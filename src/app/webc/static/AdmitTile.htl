<!DOCTYPE html>
<HTML>
<HEAD>
  <TITLE>Maple EMR</TITLE>
  <link rel="stylesheet" href="/webc/css/login.css">
  <link rel="stylesheet" href="/webc/css/dataentryform.css">
  <script>

  // checks if a string is an alphanumeric or basic punctuation
  // https://www.tutorialspoint.com/article/how-to-validate-an-input-is-alphanumeric-or-not-using-javascript
  //
  function hasAcceptableChars(str) {
    const regex = /^[a-zA-Z0-9\s!"#$%^&*()_+=,\-./:;?[\\\]|]+$/;  
    return regex.test(str);
  }

  
  // checks if a string is a ten digit number, starting with a 9, which is the PHN format
  //
  function isValidPHN(str) {
      const regex = /^9\d{9}$/;  
      return regex.test(str);
  }

  function validateForm() {
    const errLabel = document.getElementById('errLabel');
    errLabel.textContent = '';
    let isValid = true;
    
    console.log("in validateForm();");

    if (document.getElementById('patient_first_name').value.trim() == '' || !hasAcceptableChars(document.getElementById('patient_first_name').value)) {
        errLabel.textContent = "First Name is required, and can only contain letters, numbers and basic punctuation.";
        errLabel.style = "color: red";
        isValid = false;
    }

    // middle name not required
    
    if (document.getElementById('patient_last_name').value.trim() == ''|| !hasAcceptableChars(document.getElementById('patient_last_name').value)) {
      errLabel.textContent = "Last Name is required, and can only contain letters, numbers and basic punctuation.";
      errLabel.style = "color: red";
      isValid = false;
    }
    
    if (document.getElementById('phn').value.trim() == ''|| document.getElementById('phn').value.length != 10 || ! isValidPHN(document.getElementById('phn').value)) {
      errLabel.textContent = "Personal Health Number (PHN) must be provided in the format: 9#########";
      errLabel.style = "color: red";
      isValid = false;
    }

    if (document.getElementById('birthdate').value.trim() == ''|| document.getElementById('birthdate').value.length != 11|| !hasAcceptableChars(document.getElementById('birthdate').value)) {
      errLabel.textContent = "Birthdate must be provided in YYYY-MON-DD format.";
      errLabel.style = "color: red";
      isValid = false;
    }
    
    if (document.getElementById('admit_notes').value.trim() == ''|| !hasAcceptableChars(document.getElementById('admit_notes').value)) {
      errLabel.textContent = "Reason for Visit is required, and can only contain letters, numbers and basic punctuation.";
      errLabel.style = "color: red";
      isValid = false;
    }
    
        
    if (! document.getElementById("disclaimerChk").checked ) {
        errLabel.textContent = "Disclaimer must be checked";
        errLabel.style = "color: red";
        isValid = false
    }

    
    if (!isValid) {
      event.preventDefault();       // Stop the form from submitting if there are errors
    }
    else{
      admdisForm.submit();
    }

    // If isValid remains true, the browser automatically proceeds to submit!
    return isValid;
  }

  function cancelForm(){
    //if document.getElementById('encounter_id').value == "-1" {
      if( confirm('Are you sure you are done with admitting this patient? Unsaved changes will be lost.') ){
          window.location.href = "\home";
      }
    //}
    return;
  }
  </script>
</HEAD>
<BODY>

<h1>Admission Details</h1>
	
<form action="/admitsave" method="post" id="admdisForm" name="admdisForm" onSubmit="event.preventDefault(); return validateForm()">
<div>
<table>
<tr><td>
	<label id="errLabel"></label>
</td></tr>
<tr><td>
	<table>
	    <tr class="data-label">
	      <td><div>First Name</div><input type="text" name="patient_first_name" id="patient_first_name" class="data-field-rw" value="{patient_first_name}"></div></td>
	      <td><div>Last Name</div><input type="text" name="patient_last_name" id="patient_last_name" class="data-field-rw" value="{patient_last_name}"></div></td>
	      <td><div>Middle Names</div><input type="text" name="patient_middle_name" id="patient_middle_name" class="data-field-rw" value="{middle_name}"></div></td>
	    </tr>

	    <tr class="data-label">
	       <td><div>PHN</div><input type="text" name="phn" id="phn" class="data-field-rw" value="{phn}"></div></td>
	       <td><div>Birth Date</div><input type="text" name="birthdate" id="birthdate" class="data-field-rw" value="{birthdate}"></div></td>
	       <td><div>Admit Date/Time&nbsp;<div class="data-field-ro">{admit_timestamp}</div></div></td>
	    </tr>

	    <tr class="data-label">
	      <td colspan=3>
	      <div class="data-field-ro">Admit Location:&nbsp;{location_id}</div>
	      </td>
	    </tr>

	    <tr class="data-label">
	      <td colspan=3>
		<div>Reason for Visit</div><textarea id="admit_notes" name="admit_notes" rows="4" cols="50" class="data-field-rw">{admit_notes}</textarea></div>
	      </td>
	    </tr>
	</table>
	<input type="hidden" name="patient_id" id="patient_id" value="{patient_id}">
	<input type="hidden" name="encounter_id" id="encounter_id" value="{encounter_id}">
	<input type="hidden" name="form_errors" id="form_errors" value="">
	<input type="hidden" name="action_flag" id="action_flag" value="{action_flag}">
  <input type="hidden" name="user_prompt" id="user_prompt" value="{user_prompt}">
</td></tr>

<tr><td>
<p>
<div class="disclaimer"><input type="checkbox" id="disclaimerChk"><i>I confirm the above information is complete and accurate.</i></div>
</p>
</td></tr>

<tr>
<td>
<input type="submit" value="Save">
<input type="button" value="Close" onclick="cancelForm()">
</td>
</tr>

</table>
</div>
</form>


</BODY>
</HTML>