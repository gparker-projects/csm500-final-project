<tr class="data-label">
<div id="divRO_{MapleEMR::itemId}">
<table>
  <tr class="field-row">
	<td class="field-label">{count})&nbsp;{type_name}</td>
	<td class="field-value">{value}</td>
	<td class="field-value">{notes}</td>
	<td class="field-label"><i>{entry_timestamp}</i></td><td class="field-label">
	<input type="button" id="itemEdit_{MapleEMR::itemId}" name="itemEdit_{MapleEMR::itemId}" value="Edit">
  </td></tr>
</table>
</div>

<div id="divRW_{MapleEMR::itemId}" class="hidden">
<form action="/intvdtlsave" method="post" id="itemForm_{MapleEMR::itemId}" name="itemForm_{MapleEMR::itemId}" onsubmit="event.preventDefault(); return validateItvDtlsForm({MapleEMR::itemId});">
	<table>
		 <tr class="data-label">
		   <td><div class="data-field-ro"><div id="MapleEMR::InterventionDetailsTypeDropDownControl"></div></td>
		   <input type="hidden" name="intv_id" id="intv_id" value="{intervention_id}">
		   <input type="hidden" name="intv_dtls_id" id="intv_dtls_id" value="{id}">
		   <td><input type="text" name="intv_dtls_value_{MapleEMR::itemId}" id="intv_dtls_value_{MapleEMR::itemId}" class="data-field-rw" value="{value}"></td>
		   <td><div>Note</div><textarea id="intv_dtls_notes_{MapleEMR::itemId}" name="intv_dtls_notes_{MapleEMR::itemId}" rows="2" cols="50" class="data-field-rw">{notes}</textarea></td>
		   <td>
		     <input type="submit" value="Save" onclick="event.preventDefault(); return validateItvDtlsForm({MapleEMR::itemId});">
		     <input type="button" id="itemCancel_{MapleEMR::itemId}" value="Cancel">
		   </td>
		</tr>
		<tr class="data-field-ro">
			<td colspan="4">
				<label id="itemForm_{MapleEMR::itemId}_errors" class="hidden"></label>
			</td>
	    </tr>
	</table>
</form>
</div>

<script>
	const itemEdit_{MapleEMR::itemId} = document.getElementById('itemEdit_{MapleEMR::itemId}');
	const itemCancel_{MapleEMR::itemId} = document.getElementById('itemCancel_{MapleEMR::itemId}');
	const divRO_{MapleEMR::itemId} = document.getElementById('divRO_{MapleEMR::itemId}');
	const divRW_{MapleEMR::itemId} = document.getElementById('divRW_{MapleEMR::itemId}');

	itemCancel_{MapleEMR::itemId}.addEventListener('click', () => {
      console.log("itemCancel_{MapleEMR::itemId}> toggle");
	  event.preventDefault();
	  divRO_{MapleEMR::itemId}.classList.toggle('hidden');
	  divRW_{MapleEMR::itemId}.classList.toggle('hidden');
	  event.preventDefault();
	});

	itemEdit_{MapleEMR::itemId}.addEventListener('click', () => {
	  console.log("itemEdit_{MapleEMR::itemId}> toggle");
	  event.preventDefault();
	  divRO_{MapleEMR::itemId}.classList.toggle('hidden');
	  divRW_{MapleEMR::itemId}.classList.toggle('hidden');
	  event.preventDefault();
	});

</script>
</tr>