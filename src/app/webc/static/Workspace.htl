<!DOCTYPE html>
<!-- https://www.w3schools.com/css/css_navbar_vertical.asp -->
<html>
<head>
  <link rel="stylesheet" href="/webc/css/workspace.css">
  <link rel="stylesheet" href="/webc/css/dataentryform.css">
  <script src="/webc/js/home.js"></script>
</head>
<body>

<div id="userIdentity"><img src="/webc/img/mapleLogo.png"><div id="MapleEMR::UserIdentity"></div></div>
<p>
<div id="MapleEMR::LegacyMenu"></div>

<div id="mainContentArea" align="center ">

	<div id="MapleEMR::BodyTile"></div>

	<div id="MapleEMR::PatientList"></div>

	<div id="MapleEMR::UserCommands"></div>

</div>

<div id="nlpCommandArea" align="right" class="nlpCommandAreaCls">
  <form action="http://127.0.0.1:8000/nlprompt" method="post" id="nlpCommandForm" onSubmit="event.preventDefault(); return validateNLPrompt()" align="right" class="nlpCommandAreaCls">

	<input type="text" id="prompt" name="prompt" placeholder="How can I help?">
	<input type="submit" value=">>">
	<p>
	<label id="errLabel">
  </form>
</div>

<div id="footer" align="left" class="">
  
</div>

</body>
</html>