<link rel="stylesheet" href="/webc/css/login.css">
<link rel="stylesheet" href="/webc/css/home.css">
<script src="/webc/js/patientListTile.js" defer></script>

<div id="MapleEMR::PatientHeader"></div><p></p>

<div align="center" >
<form action="/discharge" method="post" id="dischargeForm" onSubmit="event.preventDefault(); return submitDischargeForm()">
  <input type="submit" value="Discharge Patient">
  <input type="hidden" id="patient_id" name="patient_id" value="{patient_id}">
  <input type="hidden" id="action_flag" name="action_flag" value="discharge">
</form>
</div>

<h1>Treatments, Procedures and Medication</h1>
<div id="MapleEMR::CurrentInterventions"></div><p></p>

<div align="center" >
<form action="/intvnew" method="post" id="addIntvForm" onSubmit="event.preventDefault(); return submitAddIntvForm()">
  <div align="left" >
      <input type="submit" value="Add/Request">
      <div id="MapleEMR::InterventionTypeDropDownControl"></div>
  </div>
  <input type="hidden" id="patient_id" name="patient_id" value="{patient_id}">
  <input type="hidden" id="encounter_id" name="encounter_id" value="{encounter_id}">
  <input type="hidden" id="intervention_id" name="intervention_id" value="-1">
</form>
</div><p></p>

<div align=\"center\">
<form action="/fast" method="post" id="fastForm" onsubmit="event.preventDefault(); return fastAction();">
  <div align="left">
      <div id="MapleEMR::FeaturePreference"></div>
  </div>
  <input type="hidden" id="patient_id" name="patient_id" value="{patient_id}">
  <input type="hidden" id="encounter_id" name="encounter_id" value="{encounter_id}">
  <input type="hidden" id="intervention_id" name="intervention_id" value="{intervention_id}">
</form>
</div>