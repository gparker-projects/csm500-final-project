<div id="MapleEMR::PatientHeader"></div><p></p>
<h3>Current Admission</h3>
<div id="MapleEMR::CurrentEncounter"></div><p></p>

<div align="center" >
<form action="/discharge" method="post" id="dischargeForm" onSubmit="event.preventDefault(); return validateForm()">
  <input type="submit" value="Discharge">
</form>
</div>

<h3>Treatments, Procedures and Medication</h3>
<div id="MapleEMR::CurrentInterventions"></div><p></p>

<div align="center" >
<form action="/addIntv" method="post" id="addIntvForm" onSubmit="event.preventDefault(); return validateForm()">
  <input type="submit" value="Add">
  <div id="MapleEMR::InterventionTypeDropDownControl"></div>
</form>
</div>

<!-- h3>Admission History</h3 -->
<div id="MapleEMR::EncounterHistory"></div>

<div id="MapleEMR::UserCommands"></div>

