<!DOCTYPE html>
<HTML>
<HEAD>
  <TITLE>MapleHMS - Discharge</TITLE>
  <link rel="stylesheet" href="/webc/css/login.css">
  <link rel="stylesheet" href="/webc/css/home.css">
  <link rel="stylesheet" href="/webc/css/dataentryform.css">
  <div id="MapleHMS::ID=Discharge"></div>
  <script> 

  // checks if a string is an alphanumeric or basic punctuation
  // https://www.tutorialspoint.com/article/how-to-validate-an-input-is-alphanumeric-or-not-using-javascript
  //
  function hasAcceptableChars(str) {
    const regex = /^[a-zA-Z0-9\s!"#$%^&*()_+=,\-./:;?[\\\]|]+$/;  
    return regex.test(str);
  }

  function validateForm() {
    const errLabel = document.getElementById('errLabel');
    errLabel.textContent = '';
    let isValid = true;

    console.log("in validateForm();");
    
    if (document.getElementById('discharge_notes').value.trim() == ''|| !hasAcceptableChars(document.getElementById('discharge_notes').value)) {
        errLabel.textContent = "Discharge notes are required, and can only contain letters, numbers and basic punctuation.";
        errLabel.style = "color: red";
        isValid = false;
        return false;
    }
    
    console.log("got here1");
    if (! document.getElementById("disclaimerChk").checked ) {
        errLabel.textContent = "Disclaimer must be checked";
        errLabel.style = "color: red";
        isValid = false;
        return false;
    }
    
    console.log("got here2");
    if( ! confirm('Are you sure you want to discharge this patient? This action can not be undone.') ){
        return false;
    }

    console.log("got here3");
    if (!isValid) {
      console.log("dischargeForm not valid");
      event.preventDefault();       // Stop the form from submitting if there are errors
    }
    else{
      console.log("submitting dischargeForm...");
      dischargeForm.submit();
    }

    // If isValid remains true, the browser automatically proceeds to submit!
    return isValid;
  }

  function cancelForm(){
    if(confirm('Are you sure you want to leave this page?')){
        window.location.href = "\home";
    }
    return;
  }
  </script>
</HEAD>
<BODY>

<h1>Discharge Details</h1>

<form action="/dischargesave" method="post" id="dischargeForm" name="dischargeForm" onSubmit="event.preventDefault(); return validateForm()">
<div>
<table>
<tr><td>
	<label id="errLabel"></label>
</td></tr>
<tr><td>
	<table>
	    <tr class="data-label">
	      <td><div>First Name</div><div class="data-field-ro"><input type="hidden" name="patient_first_name" id="patient_first_name" class="data-field-ro" value="{patient_first_name}">{patient_first_name}</div></td>
	      <td><div>Last Name</div><div class="data-field-ro"><input type="hidden" name="patient_last_name" id="patient_last_name" class="data-field-ro" value="{patient_last_name}">{patient_last_name}</div></td>
	      <td><div>Middle Names</div><div class="data-field-ro"><input type="hidden" name="patient_middle_name" id="patient_middle_name" class="data-field-ro" value="{middle_name}">{middle_name}</div></td>
	    </tr>

	    <tr class="data-label">
	       <td><div>PHN</div><div class="data-field-ro"><input type="hidden" name="phn" id="phn" class="data-field-ro" value="{phn}">{phn}</div></td>
	       <td><div>Birth Date</div><div class="data-field-ro"><input type="hidden" name="birthdate" id="birthdate" class="data-field-ro" value="{birthdate}">{birthdate}</div></td>
	       <td><div>Admit Date/Time&nbsp;</div><div class="data-field-ro"><input type="hidden" name="admit_timestamp" id="admit_timestamp" class="data-field-ro" value="{admit_timestamp}">{admit_timestamp}</div></td>
	    </tr>

	    <tr class="data-label">
	      <td colspan=3>
	        <div><div>Admit Location:&nbsp;</div><div class="data-field-ro">{location_short_name}<input type="hidden" name="location_id" id="location_id" value="{location_id}"></div></div>
	      </td>
	    </tr>

	    <tr class="data-label">
	      <td colspan=3>
		<div><div>Reason for Visit</div><div class="data-field-ro"><input type="hidden" id="admit_notes" name="admit_notes" value="{admit_notes}"><div class="data-field-ro">{admit_notes}</div></div>
	      </td>
	    </tr>

	    <tr class="data-label">
	      <td colspan=2>
		<div><div>Administrative Discharge Notes</div><textarea id="discharge_notes" name="discharge_notes" rows="4" cols="50" class="data-field-rw">{discharge_notes}</textarea></div></div>
	      </td>
	      <td><div><div>Discharge Date/Time&nbsp;</div><div class="data-field-ro">{discharge_timestamp}</div></div></td>
	    </tr>
	</table>
	
	<input type="hidden" name="patient_id" id="patient_id" value="{patient_id}">
	<input type="hidden" name="encounter_id" id="encounter_id" value="{encounter_id}">
  <input type="hidden" name="form_errors" id="form_errors" value="">
	<input type="hidden" name="action_flag" id="action_flag" value="discharge">
  <input type="hidden" name="user_prompt" id="user_prompt" value="{user_prompt}">
</td></tr>

<tr><td>
<p>
<div class="disclaimer"><input type="checkbox" id="disclaimerChk"><i>I confirm the above information is complete and accurate.</i></div>
</p>
</td></tr>

<tr>
<td>
<input type="submit" value="Discharge">
<input type="button" value="Cancel" onclick="cancelForm()">
</td>
</tr>

</table>
</div>
</form>


</BODY>
</HTML>