<h1>Discharge Patient: get_admit_discharge_tile()</h1><p>
<form action="\admdis" method="post" id="admdisForm" name="admdisForm">
<table>
    <tr><td>
      <div class="data-label">First Name</div><div class="data-field-ro"><!--{first_name}-->last_name</div>
      <div class="data-label">Last Name</div><div class="data-field-ro"><!--{patient_first_name}--></div>
      <div class="data-label">Middle Names</div><div class="data-field-ro"><!--{middle_name}--></div>
    </td></tr>

    <tr><td>
    PHN <!--{phn}-->
    Birth Date <!--{birthdate}-->
    Admit Date/Time <!--{admit_timestamp}-->
    Location <!--{location}-->
    </td></tr>

    <tr><td>
	    Reason for Visit <!--{admit_notes}-->
    </td></tr>

    <tr><td>
     Discharge Date/Time <!--{discharge_timestamp}--> &nbsp;
    </td></tr>

    <tr><td>
	 Outpatient Treatment Plan <textarea id="discharge_notes" name="discharge_notes" rows="4" cols="50" placeholder=""></textarea>
    </td></tr>

</table>
<p>
<h2>Baseline Vitals</h2>
<table>
    <tr>
	<td>
	Temp (C) <input type="text" name="temperature" id="temperature" value="">
	Blood Pressure <input type="text" name="blood_pressure" id="blood_pressure" value="">
	Weight (Kg) <input type="text" name="weight" id="weight" value="">
	</td>
    </tr>
    <tr>
	<td>
	Additional Observations<textarea id="intervention_notes" name="intervention_notes" rows="4" cols="50" placeholder=""></textarea>
	</td>
    </tr>
</table>
<input type="hidden" name="patient_id" id="patient_id" value="-1">
</form>

<th class="data-label">Last, First Name</th>