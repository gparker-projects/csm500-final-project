<!DOCTYPE html>
<!-- https://www.w3schools.com/css/css_navbar_vertical.asp -->
<html>
<head>
  <link rel="stylesheet" href="/webc/css/home.css">
  <link rel="stylesheet" href="/webc/css/dataentryform.css">
  <script src="/webc/js/home.js"></script>
  <script src="/webc/js/nle.js"></script>
</head>
<body>

<div class="userIdentity"><img src="/webc/img/mapleLogo.png" alt="MapleHMS" title="<div id="MapleHMS::UserIdentity"></div>"><div id="MapleHMS::ReleaseNumber"></div></div>
<p>
<div id="MapleHMS::LegacyMenu"></div>

<div id="mainContentArea" align="left">

	<div id="MapleHMS::BodyTile"></div>

	<div id="MapleHMS::PatientList"></div>

</div>


<div id="nlpCommandArea" align="left" class="nlpCommandAreaCls">
  <div id="MapleHMS::NLPCanvas"></div>
  <form action="/nlprompt" method="post" id="nlpCommandForm" name="nlpCommandForm" onSubmit="event.preventDefault(); return validateNLPrompt()" align="left" class="nlpCommandAreaCls">
	
	<div align="right"><textarea id="prompt" name="prompt" rows="3" cols="20" class="data-field-rw" placeholder="How can I help?"></textarea>
	<input type="submit" value=">>"></div>
	<label id="errLabelNL" name="errLabelNL" class="data"></label>
  </form>
</div>

<div id="footer" align="left" class="">
  
</div>

</body>
</html>