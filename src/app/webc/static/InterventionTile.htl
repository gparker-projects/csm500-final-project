<!DOCTYPE html>
<HTML>
<HEAD>
  <TITLE>Maple EMR</TITLE>
  <link rel="stylesheet" href="/webc/css/login.css">
  <script src="/webc/js/interventionTile.js" defer></script>
</HEAD>
<BODY>

<h1>{intervention_type}&nbsp;Details</h1>

<div>

<table>
<tr>

<form action="/intvsave" method="post" id="intvForm" name="intvForm" onSubmit="event.preventDefault(); return validateForm()">
<input type="hidden" name="form_errors" id="form_errors" value="">
<input type="hidden" name="encounter_id" id="encounter_id" value="{encounter_id}">
<input type="hidden" name="intervention_id" id="intervention_id" value="{intervention_id}">
<input type="hidden" name="intervention_type_id" id="intervention_type_id" value="{intervention_type_id}">
<input type="hidden" name="patient_id" id="patient_id" value="{patient_id}">
<input type="hidden" name="target_id" id="target_id" value="{patient_id}">

<td>
	<label id="errLabel"></label>
	<table>

	    <tr class="data-label">
	       <td><div>Type</div><div class="data-field-ro">{intervention_type}</div></td>
	       <td><div>Scheduled Date/Time</div><input type="text" name="scheduled_timestamp" id="scheduled_timestamp" class="data-field-rw" value="{scheduled_timestamp}"></div></td>
	       <td><div>Performed Date/Time</div><input type="text" name="performed_timestamp" id="performed_timestamp" class="data-field-rw" value="{performed_timestamp}"></div></td>
	    </tr>
	    
	    <tr class="data-label">
	      <td colspan=3>
	    	  <div class="data-field-ro">Location:&nbsp;{location_id}</div>
	      </td>
        </tr>

	    <tr class="data-label">
	      <td colspan=2>
	          <div class="data-field-ro">Assigned to:&nbsp;<div id="MapleEMR::UserIdDropDownControl"></div></div>
	      </td>
	      <td>
	          <div class="data-field-ro">Status:&nbsp;<div id="MapleEMR::StatusIdDropDownControl"></div></div>
	      </td>
	    </tr>

	    <tr class="data-label">
	      <td colspan=3>
		<div>Description</div><textarea id="description" name="description" rows="4" cols="50" class="data-field-rw">{description}</textarea></div>
	      </td>
	    </tr>
	    
	    <tr class="data-label">
	      <td colspan=3>
		<div>Notes</div><textarea id="notes" name="notes" rows="4" cols="50" class="data-field-rw">{notes}</textarea></div>
	      </td>
	    </tr>
	</table>
</td></tr>

<tr>
<td>
<input type="submit" value="Save">
<input type="button" value="Close" onclick="cancelForm()">
<input type="button" value="+" id="btnShowHideNewMeasure" {hide_add_new_measure}>
</td>
</tr>
</form>







<div align="left">
<tr>
<td>

<div id="divaddNewMeasure" class="hidden">
<form action="/intvdtlnew" method="post" id="addMeasureForm" name="addMeasureForm" onsubmit="event.preventDefault(); return validateAddMeasureForm(0);">
    <input type="hidden" name="addFrm_patient_id" id="addFrm_patient_id" value="{patient_id}">
	<table>
		 <tr class="data-label">
		   <td><div class="data-field-ro"><div id="MapleEMR::InterventionDetailsTypeDropDownControl"></div></td>
		   <input type="hidden" name="addFrm_intv_id" id="addFrm_intv_id" value="{intervention_id}">
		   <input type="hidden" name="addFrm_intv_dtls_id" id="addFrm_intv_dtls_id" value="-1">
		   <td><div>Value</div><input type="text" name="addFrm_value" id="addFrm_value" class="data-field-rw" value=""></td>
		   <td><div>Note</div><textarea id="addFrm_notes" name="addFrm_notes" rows="2" cols="50" class="data-field-rw"></textarea></td>
		   <td>
		       <input type="submit" value="Add" onclick="event.preventDefault(); return validateAddMeasureForm(0);">
		       <input type="button" id="itemCancel_0" value="Cancel" onClick="event.preventDefault(); btnShowHideNewMeasure.click();">
		   </td>
		</tr>
		<tr class="data-field-ro">
			<td colspan="4">
				<label id="addFrm_errors" class="hidden"></label>
			</td>
	    </tr>
	</table>

</form>

</td>
</tr>

<tr>
<td>
<div id="MapleEMR::FeaturePreference"></div>

<div id="MapleEMR::InterventionDetailsList"></div>
<p>

</td>
</tr>







<tr>
<td>


</div>
</div>
<!--div align="left"-->
  <!--div id="MapleEMR::FeaturePreference"></div-->
<!--/div-->
</td>
</tr>

</table>

</BODY>
</HTML>